{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_ENV === 'production' ? 1 : 0)\"",
  "buildCommand": "corepack pnpm build:vercel",
  "installCommand": "corepack enable && corepack pnpm install --frozen-lockfile"
}
