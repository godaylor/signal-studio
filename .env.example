# Generated by `pnpm env:init`. Do not copy these values into production.
DATABASE_URL=postgresql://signal_studio:signal_studio@127.0.0.1:32110/signal_studio
SIGNAL_STUDIO_APP_PORT=32109
SIGNAL_STUDIO_DB_PORT=32110
APP_SECRET=generated-by-pnpm-env-init
TWO_FACTOR_ENCRYPTION_KEY=generated-by-pnpm-env-init

# Optional security tuning. Management API CORS is same-origin by default.
# MANAGEMENT_API_ALLOWED_ORIGIN=https://analytics.example.com
# Trust only a header overwritten by your reverse proxy; unset ignores all proxy IP headers.
# CLIENT_IP_HEADER=x-real-ip
# AUTH_TOKEN_TTL_SECONDS=28800
# PARTIAL_AUTH_TOKEN_TTL_SECONDS=300
# COLLECTION_TOKEN_TTL_SECONDS=2678400
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# LOGIN_RATE_LIMIT_RETENTION_SECONDS=86400

# App and export worker must share this directory and APP_SECRET.
# Containers use a dedicated volume at /app/exports. Local default is .local/exports.
# EXPORT_STORAGE_PATH=.local/exports

# Free serverless profile (server-only values, never NEXT_PUBLIC_*).
# SIGNAL_STUDIO_SERVERLESS=1
# EXPORT_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=from-provider-secret-settings
# SUPABASE_EXPORT_BUCKET=signal-exports
# JOBS_CRON_SECRET=independent-random-secret
# DATABASE_URL=Supavisor-transaction-pooler-6543-with-verified-TLS
# DIRECT_DATABASE_URL=direct-or-session-pooler-5432-for-local-migrations-only
